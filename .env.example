# These are examples, not usable secrets. Never commit .env files.
MCP_API_KEY=generate-a-long-random-secret
PUBLIC_BASE_URL=https://catalog.example.com
STREMIO_FEED_TOKEN=generate-a-different-long-random-secret
# Existing Upstash database or an Upstash-compatible HTTPS Redis REST service.
# Standard redis:// TCP URLs are not supported without an adapter.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=configure-in-vercel-secrets
# Optional; enables updating the Stremio account manifest automatically.
# STREMIO_AUTH_KEY=configure-securely

# Optional: open a Stremio detail page on a paired Android TV using FCM.
# Disabled by default. Without the explicit 'true', MCP still exposes only five tools.
TV_OPEN_ENABLED=false
# FCM_PROJECT_ID=your-free-firebase-project-id
# FCM_SERVICE_ACCOUNT_JSON=private-service-account-json-vercel-secret
