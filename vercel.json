{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.go": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/tv/setup", "destination": "/api/mcp?resource=tv&action=setup" },
    { "source": "/tv/setup.js", "destination": "/api/mcp?resource=tv&action=setup-js" },
    { "source": "/tv/setup.css", "destination": "/api/mcp?resource=tv&action=setup-css" },
    { "source": "/tv/admin", "destination": "/api/mcp?resource=tv&action=admin" },
    { "source": "/tv/pair/start", "destination": "/api/mcp?resource=tv&action=pair-start" },
    { "source": "/tv/pair/status", "destination": "/api/mcp?resource=tv&action=pair-status" },
    { "source": "/tv/device/token", "destination": "/api/mcp?resource=tv&action=device-token" },
    { "source": "/tv/device/receipt", "destination": "/api/mcp?resource=tv&action=device-receipt" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/stremio/:token/manifest.json", "destination": "/api/mcp?token=:token&resource=manifest" },
    { "source": "/stremio/:token/catalog/:type/:id.json", "destination": "/api/mcp?token=:token&resource=catalog&type=:type&id=:id" },
    { "source": "/stremio/:token/:version/manifest.json", "destination": "/api/mcp?token=:token&resource=manifest" },
    { "source": "/stremio/:token/:version/catalog/:type/:id.json", "destination": "/api/mcp?token=:token&resource=catalog&type=:type&id=:id" }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
