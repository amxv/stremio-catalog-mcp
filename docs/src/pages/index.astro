---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const capabilities = [
  { title: "ChatGPT chooses", body: "Let your AI agent browse, research and pick titles. No competing recommendation system." },
  { title: "Stremio displays", body: "Native movie and series rows populated with Cinemeta-compatible IMDb IDs." },
  { title: "Edit everything", body: "Rename, reorder, append, replace, clear or remove titles and whole catalog rows." },
  { title: "Streams stay yours", body: "No playback providers, metadata replacements, tracking databases or TV-side modifications." }
];
---

<BaseLayout title={`${siteConfig.name} | ${siteConfig.strapline}`} description={siteConfig.description} siteConfig={siteConfig} primaryNav={primaryNav}>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">MCP → Stremio</p>
      <h1>Send your picks straight to the big screen.</h1>
      <p class="hero__lede">
        Ask your AI assistant for movies or shows. It picks the titles and publishes
        a new collection on your Stremio home screen, ready for your existing streaming addons.
      </p>
      <p class="hero__annotation">No recommendation engine. No new TV app. Just native Stremio catalogs.</p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/quickstart">Quickstart</a>
        <a class="button button--ghost" href="/docs/architecture">Architecture</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">One conversation. One catalog.</p>
      <ul class="hero__signal-list">
        <li><strong>You:</strong> Find funny murder mysteries rated over 7 on IMDb.</li>
        <li><strong>Assistant:</strong> Recommends and calls catalog_put.</li>
        <li><strong>Stremio:</strong> Shows a named row of your selected series.</li>
      </ul>
      <div class="hero__terminal">
        <span>{'catalog_put({ name, type, items })'}</span>
        <span>catalog_list()</span>
        <span>{'catalog_clear({ row_id })'}</span>
      </div>
    </aside>
  </section>
  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">Included infrastructure</p>
      <h2>Your recommendations, in the right place.</h2>
      <p>Stremio handles viewing. Cinemeta handles title metadata. Your agent handles recommendations. We handle the handoff.</p>
    </div>
    <div class="proof-grid">
      {capabilities.map((item) => (
        <article class="proof-card"><h3>{item.title}</h3><p>{item.body}</p></article>
      ))}
    </div>
  </section>
  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Guides</p>
      <h2>Build, deploy, and start curating.</h2>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="shell closing-note">
    <p>Apache-2.0 licensed Go service, designed for a future open-source release.</p>
  </section>
</BaseLayout>
