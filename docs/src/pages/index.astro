---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const capabilities = [
  { title: "Real MCP from day one", body: "Two working sample tools demonstrate unstructured text and typed JSON output." },
  { title: "Native Go", body: "Official MCP Go SDK with tiny handlers and straightforward Go tests." },
  { title: "Serverless", body: "Stateless Streamable HTTP runs as a single Go Function on Vercel." },
  { title: "Docs included", body: "A fully isolated Astro + ZueDocs site can deploy from the same GitHub repository." }
];
---

<BaseLayout title={`${siteConfig.name} | ${siteConfig.strapline}`} description={siteConfig.description} siteConfig={siteConfig} primaryNav={primaryNav}>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">Go · MCP · Vercel</p>
      <h1>Start with a server that already speaks MCP.</h1>
      <p class="hero__lede">
        Build your next MCP service in Go without reimplementing HTTP transport,
        JSON-RPC wiring, authentication or deployments. Replace the sample tools and ship.
      </p>
      <p class="hero__annotation">No CLI, npm distribution, release tags, or persistent session store required.</p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/quickstart">Quickstart</a>
        <a class="button button--ghost" href="/docs/architecture">Architecture</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">Included MCP examples</p>
      <ul class="hero__signal-list">
        <li><strong>echo_text</strong> — validated text input and text output.</li>
        <li><strong>add_numbers</strong> — validated numeric input and structured JSON output.</li>
        <li><strong>?key=</strong> — production API key authentication with fail-closed defaults.</li>
      </ul>
      <div class="hero__terminal">
        <span>api/mcp.go</span>
        <span>pkg/server/tools.go</span>
        <span>make check</span>
      </div>
    </aside>
  </section>
  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">Included infrastructure</p>
      <h2>Spend your time on the tool behavior.</h2>
      <p>Transport, deployment, tests, and docs are included. The samples are tiny enough to understand and replace.</p>
    </div>
    <div class="proof-grid">
      {capabilities.map((item) => (
        <article class="proof-card"><h3>{item.title}</h3><p>{item.body}</p></article>
      ))}
    </div>
  </section>
  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Guides</p>
      <h2>From template to deployed MCP.</h2>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="shell closing-note">
    <p>A reusable foundation, not a framework. Keep the deployment simple and replace only what your tools need.</p>
  </section>
</BaseLayout>
