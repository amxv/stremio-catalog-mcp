---
import "../styles/landing.css";
import ArrowUpRight from "../components/ArrowUpRight.astro";
import Asterisk from "../components/Asterisk.astro";

const examples = [
  { index: "01", label: "Psych", year: "2006", kind: "SERIES", art: "psych" },
  { index: "02", label: "Monk", year: "2002", kind: "SERIES", art: "monk" },
  { index: "03", label: "Only Murders", year: "2021", kind: "SERIES", art: "murders" }
];

const steps = [
  { number: "01", type: "A CONVERSATION", title: "Find your next watch.", detail: "Ask for recommendations, or name a movie or show. Optional title lookup helps your agent find the exact IMDb ID, even when names overlap.", example: "“Some clever, funny murder mysteries. Nothing too dark.”" },
  { number: "02", type: "YOUR STREMIO, ORGANIZED", title: "Put it where you want.", detail: "Make collections, reorder Home rows, or check what you've already watched. Your agent handles the requests; Stremio keeps your existing add-ons.", example: "catalogs_update · home_layout_update · watch_history" },
  { number: "03", type: "YOUR TV", title: "Skip straight to the couch.", detail: "Browse your new catalog in Stremio, or opt into the Android TV remote to open the exact title or episode. Streaming and playback stay in Stremio.", example: "Murder mysteries with a wink  →" }
];

const features = [
  { id: "A", title: "Make a row. Make it yours.", copy: "Create, edit, and reorder custom movie and TV collections, with titles and posters from Cinemeta." },
  { id: "B", title: "Shape your whole Home screen.", copy: "Hide unwanted default rows and move catalogs or whole installed add-ons without removing your streaming providers." },
  { id: "C", title: "Know what you've watched.", copy: "Check up to 50 titles at once, see the episodes you've finished, and update watch history without future-episode spoilers." },
  { id: "D", title: "Find the exact title.", copy: "Optional TMDB lookup finds IMDb IDs in batches, with year, language, genres, and available IMDb ratings." },
  { id: "E", title: "Open it on Android TV.", copy: "Optionally open a movie, show, or exact episode on a paired TV. No autoplay or always-running computer." },
  { id: "F", title: "Your agent, your add-ons.", copy: "ChatGPT or any MCP client can use the same tools. Your installed Stremio providers still handle the streams." }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101512" />
    <meta name="description" content="Manage Stremio with your AI assistant: custom catalogs, Home layout, watch history, and optional IMDb title lookup and Android TV control." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Stremio Catalog MCP — From chat to couch" />
    <meta property="og:description" content="Create catalogs, organize Home, check watch history, find IMDb IDs, and open titles on Android TV, all with an MCP agent." />
    <title>Stremio Catalog MCP — From chat to couch</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="site-noise" aria-hidden="true"></div>
    <div class="shell">
      <header class="topbar">
        <a href="/" class="brand" aria-label="Stremio Catalog MCP home">
          <span class="brand-glyph" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><rect x="2" y="3" width="28" height="7" rx="2" fill="currentColor"/><rect x="2" y="13" width="28" height="7" rx="2" fill="currentColor" opacity=".66"/><rect x="2" y="23" width="19" height="7" rx="2" fill="currentColor" opacity=".34"/></svg></span>
          <span>stremio<span class="slash">/</span>catalog<span class="brand-tag">mcp</span></span>
        </a>
        <nav class="nav" aria-label="Main navigation">
          <a href="#how-it-works">How it works</a>
          <a href="#why-it-exists">The idea</a>
          <a href="/docs">Documentation <ArrowUpRight /></a>
          <a href="https://github.com/amxv/stremio-catalog-mcp" aria-label="Source repository on GitHub" title="Source repository" target="_blank" rel="noopener noreferrer" class="github-link"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9A11.1 11.1 0 0 0 8.49 22.54c.56.1.76-.24.76-.54v-2.12c-3.09.67-3.74-1.32-3.74-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.7.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.6 1.21 3.23.93.1-.72.39-1.21.7-1.49-2.47-.28-5.06-1.23-5.06-5.49 0-1.22.43-2.21 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.15A10.6 10.6 0 0 1 12 6.42c.94 0 1.88.13 2.77.38 2.11-1.45 3.05-1.15 3.05-1.15.61 1.54.23 2.68.11 2.96.72.79 1.15 1.78 1.15 3 0 4.27-2.59 5.21-5.07 5.49.4.35.75 1.03.75 2.08V22c0 .3.2.65.76.54A11.1 11.1 0 0 0 12 .9Z"/></svg></a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="pulse" aria-hidden="true"></span> THE MISSING LINK IN MOVIE NIGHT <span class="eyebrow-counter">/ 001</span></p>
            <h1 id="hero-title">From a good question to a <em>great watch.</em></h1>
            <p class="lead">Create collections, arrange your Home screen, and manage watch history with your AI assistant. Optional title lookup and TV control make the handoff even easier.</p>
            <div class="hero-actions"><a class="btn btn-primary" href="/docs/quickstart">Get started <ArrowUpRight /></a><a class="btn btn-outline" href="/docs/tools">Explore the seven tools <ArrowUpRight /></a></div>
            <p class="hero-footnote"><Asterisk /> <strong>Five core tools. Two optional extras.</strong> Your streaming add-ons stay yours.</p>
          </div>

          <div class="hero-art" aria-label="Illustration of an AI conversation sending a catalog row to Stremio">
            <div class="orbit orbit-a" aria-hidden="true"></div><div class="orbit orbit-b" aria-hidden="true"></div>
            <div class="chat-bubble"><div class="chat-star" aria-hidden="true"><Asterisk /></div><div><span class="chat-label">YOU, TO YOUR AGENT</span><p id="prompt-text">“Show me witty murder mysteries with an IMDb rating above 7.”</p></div><span class="chat-arrow" aria-hidden="true"><ArrowUpRight /></span></div>
            <div class="transfer" aria-hidden="true"><span class="dash"></span><span class="transfer-pill">catalogs_update <ArrowUpRight /></span><span class="dash"></span></div>
            <div class="tv-frame"><div class="tv-screen"><div class="tv-top"><span class="tv-wordmark"><span aria-hidden="true">◈</span> stremio</span><span>DISCOVER</span><span class="tv-avatar" aria-hidden="true">S</span></div><div class="tv-main"><div class="tv-kicker"><i></i> YOUR CUSTOM CATALOG</div><div class="tv-title-row"><h2 id="catalog-title">Murder mysteries with a wink</h2><span>SEE ALL <span aria-hidden="true">→</span></span></div><div class="poster-grid">
              {examples.map((item) => (<div class={`poster poster-${item.art}`} data-poster><div class="poster-pattern" aria-hidden="true"><i></i><i></i><i></i></div><span class="poster-no">{item.index} / 03</span><span class="poster-caption"><strong data-poster-title>{item.label}</strong><small data-poster-meta>{item.year} · {item.kind}</small></span></div>))}
            </div><div class="tv-status"><span><i></i> YOUR EXISTING STREAMING ADD-ONS</span><span>READY TO WATCH <ArrowUpRight /></span></div></div></div></div><div class="tv-foot" aria-hidden="true"></div>
            <div class="demo-picker"><span>TRY ANOTHER REQUEST</span><div class="demo-options"><button type="button" class="selected" data-scene="mystery" aria-pressed="true">Witty mysteries</button><button type="button" data-scene="space" aria-pressed="false">Mind-bending sci-fi</button><button type="button" data-scene="comedy" aria-pressed="false">Comfort comedy</button></div></div>
            <p class="illustration-label">ILLUSTRATIVE PREVIEW · BUILT WITH THE REAL STREMIO CATALOG FORMAT</p>
          </div>
        </section>

        <div class="marquee" aria-label="Your agent recommends. Stremio plays. No new streaming app."><div aria-hidden="true"><span>THE RECOMMENDATION IS THE EASY PART</span><b><Asterisk /></b><span>GETTING IT ON YOUR TV IS THE MAGIC</span><b><Asterisk /></b><span>THE RECOMMENDATION IS THE EASY PART</span><b><Asterisk /></b><span>GETTING IT ON YOUR TV IS THE MAGIC</span><b><Asterisk /></b></div></div>

        <section class="section how" id="how-it-works"><div class="section-intro"><div><p class="eyebrow eyebrow-light">/ THE THREE ACTS</p><h2>A little less browsing.<br /><em>A lot more watching.</em></h2></div><p>From conversation to couch, in three simple steps. Your agent manages the details. Your existing Stremio setup does the streaming.</p></div><div class="steps">{steps.map((step) => (<article class="step"><div class="step-top"><span>{step.number} / 03</span><span>{step.type}</span></div><div class="step-symbol" aria-hidden="true">{step.number === "01" ? <Asterisk /> : step.number === "02" ? <ArrowUpRight /> : <svg viewBox="0 0 24 24" class="glyph-play" fill="currentColor" aria-hidden="true"><path d="M6 3.5c0-.8.9-1.2 1.5-.8l13 8.5c.6.4.6 1.3 0 1.7l-13 8.5c-.6.4-1.5 0-1.5-.8z" /></svg>}</div><h3>{step.title}</h3><p>{step.detail}</p><div class="step-example">{step.example}</div></article>))}</div></section>

        <section class="statement" id="why-it-exists"><p class="eyebrow eyebrow-dark">/ NOT ANOTHER RECOMMENDATION ENGINE</p><h2>You've already found <em>the good stuff.</em><br /><span>Now give it somewhere to live.</span></h2><div class="statement-bottom"><p>ChatGPT knows the conversation. Cinemeta knows the movie. Your streaming add-ons know how to play it. <strong>This MCP is the missing handoff.</strong></p><div class="statement-seal" aria-hidden="true"><span>BUILT FOR</span><strong>THE<br />COUCH</strong><span>NOT THE FEED</span></div></div></section>

        <section class="section feature-section"><div class="section-intro feature-intro"><div><p class="eyebrow eyebrow-light">/ FIVE CORE TOOLS + TWO OPTIONAL</p><h2>Make your screen<br /><em>feel like yours.</em></h2></div><p>From titles to watch history, your agent can handle the busywork. Turn on lookup or Android TV control only if you want it.</p></div><div class="features">{features.map((feature) => (<article class="feature"><span class="feature-id">{feature.id} /</span><h3>{feature.title}</h3><p>{feature.copy}</p><span class="feature-arrow" aria-hidden="true"><ArrowUpRight /></span></article>))}</div></section>

        <section class="cta-band"><Asterisk class="cta-decoration" /><div><p class="eyebrow eyebrow-dark">/ READY FOR MOVIE NIGHT?</p><h2>Talk about it.<br /><em>Then watch it.</em></h2><p>Self-host the Go MCP server and keep using your Stremio add-ons. Add title lookup or TV control when you're ready.</p></div><a href="/docs/quickstart" class="cta-link">Read the quickstart <ArrowUpRight /></a></section>
      </main>

      <footer class="footer"><a class="footer-brand" href="/">stremio<span>/</span>catalog<span class="footer-mcp">mcp</span></a><span>FROM CHAT TO COUCH. NO EXTRA CHANNELS.</span><div><a href="/docs">Docs <ArrowUpRight /></a><a href="/docs/tools">MCP tools <ArrowUpRight /></a><a href="https://github.com/amxv/stremio-catalog-mcp" target="_blank" rel="noopener noreferrer">Source <ArrowUpRight /></a></div></footer>
      <div class="source-credit" aria-label="Metadata source credits">
        <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer" aria-label="The Movie Database"><img src="/tmdb-logo.svg" width="28" height="21" alt="TMDB logo" loading="lazy" /></a>
        <span>Optional title lookup uses TMDB data. This product uses the TMDB API but is not endorsed or certified by TMDB.</span>
        <a href="/docs/architecture#data-credits">Credits</a>
      </div>
    </div>

    <script>
      const scenes: Record<string, { prompt: string; title: string; items: [string, string, string][] }> = {
        mystery: { prompt: '“Show me witty murder mysteries with an IMDb rating above 7.”', title: "Murder mysteries with a wink", items: [["Psych", "2006 · SERIES", "psych"], ["Monk", "2002 · SERIES", "monk"], ["Only Murders", "2021 · SERIES", "murders"]] },
        space: { prompt: '“Give me intelligent science fiction that messes with my head.”', title: "Reality, reconsidered", items: [["Arrival", "2016 · MOVIE", "arrival"], ["Severance", "2022 · SERIES", "severance"], ["Dark", "2017 · SERIES", "dark"]] },
        comedy: { prompt: '“Recommend some genuinely great comfort-watch comedies.”', title: "One more episode", items: [["Community", "2009 · SERIES", "community"], ["The Good Place", "2016 · SERIES", "goodplace"], ["Ted Lasso", "2020 · SERIES", "tedlasso"]] }
      };

      const buttons = document.querySelectorAll<HTMLButtonElement>("[data-scene]");
      const prompt = document.getElementById("prompt-text");
      const rowTitle = document.getElementById("catalog-title");
      const posters = Array.from(document.querySelectorAll<HTMLElement>("[data-poster]"));
      for (const button of buttons) {
        button.addEventListener("click", () => {
          const scene = scenes[button.dataset.scene ?? "mystery"];
          if (!scene || !prompt || !rowTitle) return;
          for (const choice of buttons) { const selected = choice === button; choice.classList.toggle("selected", selected); choice.setAttribute("aria-pressed", String(selected)); }
          prompt.textContent = scene.prompt;
          rowTitle.textContent = scene.title;
          posters.forEach((poster, index) => {
            const [title, meta, art] = scene.items[index];
            poster.className = `poster poster-${art}`;
            const nameElement = poster.querySelector("[data-poster-title]");
            const metaElement = poster.querySelector("[data-poster-meta]");
            if (nameElement) nameElement.textContent = title;
            if (metaElement) metaElement.textContent = meta;
          });
        });
      }
    </script>
  </body>
</html>
